# نفس مشروع Supabase اللي يستخدمه التطبيق والسيرفر -- anon key آمن للعميل،
# service role key سيرفر فقط (يتخطى RLS، لا يوصل لأي كود عميل أبداً).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- منصة الأفيليت ---
# مفتاح تشفير بيانات اعتماد المزوّدين (AES-256-GCM، 64 حرف hex = 32 بايت).
# لازم يُضبط قبل حفظ أي بيانات اعتماد حقيقية (Awin/CJ API keys) من تبويب
# "البرامج". ولّده بـ:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AFFILIATE_CREDENTIAL_KEY=

# سر مشترك مع xbloom-recipe-engine/server (اللي يشغّل طابور مهام الأفيليت
# كل 15 دقيقة عبر node-cron -- لا يوجد Vercel/Netlify Cron بهذا المشروع).
# لازم تكون نفس القيمة بالضبط بمتغيرات بيئة Railway لذاك السيرفر.
AFFILIATE_JOBS_SECRET=

# ملح إضافي لتشفير IP بسجلات الكليكات (خصوصية -- لا يُخزَّن IP خام أبداً).
# اختياري: لو ما اتضبط، يُستخدم SUPABASE_SERVICE_ROLE_KEY كملح افتراضي --
# يشتغل بدون إعداد إضافي، بس يُنصح تضبطه بمفتاح مستقل لو تبي تدويره بمعزل.
AFFILIATE_IP_HASH_SALT=

# لما true، ويبهوك شراء الأفيليت (webhooks/affiliate-purchase) يخزّن
# الحدث الخام ويجندل معالجة غير متزامنة (عبر طابور مهام الأفيليت) بدل
# المعالجة الفورية. الافتراضي false (توافق رجعي) -- غيّره لـ true بعد ما
# تتأكد إن الطابور يشتغل صح.
AFFILIATE_QUEUE_WEBHOOKS=false

# --- سوق المعدات المستعملة (بوابة الدفع Telr) ---
# قيم فعلية تجيك من لوحة تحكم Telr بعد فتح حساب تاجر -- كلها فاضية الآن
# (ما فيه حساب مفتوح بعد)، بدونها راوت إنشاء جلسة الدفع يرجّع
# telr_not_configured بدل ما يفشل بغموض.
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_TEST_MODE=1

# --- تكاملات ثانية موجودة بالمشروع ---
ANTHROPIC_API_KEY=
POSTHOG_PERSONAL_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUBMITTER_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
